{
  "name": "jumpstart-mixer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate-pack-index && tsc -b && vite build",
    "dev": "pnpm run generate-pack-index && vite --host",
    "generate-pack-index": "node scripts/generate-pack-index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm run test:unit && pnpm exec playwright test",
    "test:coverage": "pnpm run generate-pack-index && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:unit": "pnpm run generate-pack-index && vitest run",
    "test:watch": "pnpm run generate-pack-index && vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "jotai": "^2.20.3",
    "lucide-react": "^1.50.0",
    "motion": "^13.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-responsive": "^10.0.1",
    "scryfall-api": "^4.0.5",
    "spinkit": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tailwindcss": "^1.14.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.8.1",
      "onFail": "download"
    }
  }
}
